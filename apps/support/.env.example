# Browser (bundled into the app). Local values come from `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:57121
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (api/ functions; read by Vercel, or by the Vite dev server locally).
SUPABASE_URL=http://127.0.0.1:57121
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# Signing secret from the Resend webhook (event: email.received) -> /api/inbound-email
RESEND_WEBHOOK_SECRET=
# Inbound address customers write to; replies use support+<ticket token>@ its domain.
SUPPORT_ADDRESS=support@blue-core.tech
# Verified Resend sending address for agent replies.
SUPPORT_FROM_ADDRESS=support@blue-core.tech
# Local only: "log" records replies without emailing anyone.
SUPPORT_EMAIL_TRANSPORT=
VITE_SUPPORT_EMAIL=
# Google Calendar booking (Phase 6). OAuth client from Google Cloud Console
# (type "Web application"); see docs/booking-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
# Long random string; encrypts agents' refresh tokens and signs OAuth state.
GOOGLE_TOKEN_KEY=
# Local only: "fake" simulates Google (always free, fake Meet links).
GOOGLE_CALENDAR_TRANSPORT=

# AI triage (Phase 7). Server-only. Claude reads new tickets and suggests a
# priority, product, tags and a draft reply. See docs/ai-triage.md.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5.
# AI_TRIAGE_MODEL=
# Local only: keyword rules instead of Claude, no API key needed.
# AI_TRIAGE_TRANSPORT=fake
