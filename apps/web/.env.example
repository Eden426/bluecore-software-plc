# Server-only. Set real values in Vercel or in ignored .env for vercel dev.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Client analytics (optional).
# Vercel Web Analytics is included with Vercel Pro and active out-of-the-box.
# To optionally mirror events to Google Analytics 4 (GA4) at $0 cost, set your Measurement ID:
VITE_GA_MEASUREMENT_ID=G-VVMVSLLBVB
